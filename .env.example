# Never commit real credentials. Rotate secrets through the deployment platform.
# URL-encode special characters in username/password values.
DATABASE_URL=mysql+pymysql://marketingiq:change-me@127.0.0.1:3306/marketingiq?charset=utf8mb4
DB_POOL_RECYCLE_SECONDS=280
APP_ENV=development
AUTH_SECRET=replace-with-a-random-development-value
HUNTER_API_KEY=
PUBLIC_WEB_FRESHNESS_HOURS=24
EXTERNAL_PROVIDER_FRESHNESS_HOURS=168
AUTOMATION_CRON_BATCH_SIZE=20

# Outbound email. These values are suitable for a normal shared-hosting SMTP account.
# Leave SMTP_HOST / SMTP_FROM_EMAIL blank until outbound sending is intentionally enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MarketingIQ
SMTP_USE_SSL=false
SMTP_STARTTLS=true