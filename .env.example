# Never commit real credentials. Rotate secrets through the deployment platform.
# URL-encode special characters in username/password values.
DATABASE_URL=mysql+pymysql://marketingiq:change-me@127.0.0.1:3306/marketingiq?charset=utf8mb4
DB_POOL_RECYCLE_SECONDS=280
APP_ENV=development
AUTH_SECRET=replace-with-a-random-development-value
HUNTER_API_KEY=
PUBLIC_WEB_FRESHNESS_HOURS=24
EXTERNAL_PROVIDER_FRESHNESS_HOURS=168
AUTOMATION_CRON_BATCH_SIZE=20
PIPELINE_SYNC_BATCH_SIZE=100

# Optional AI-assisted campaign drafting. Leave OPENAI_API_KEY blank to keep zero-cost deterministic drafting.
OPENAI_API_KEY=
CAMPAIGN_AI_MODEL=gpt-5.6-luna
CAMPAIGN_AI_TIMEOUT_SECONDS=30

# Signed normalized engagement webhook ingestion. Use a random secret of at least 32 characters.
# Provider-specific adapters/gateways should sign timestamp + "." + exact request body using HMAC-SHA256.
ENGAGEMENT_WEBHOOK_SECRET=
ENGAGEMENT_WEBHOOK_MAX_AGE_SECONDS=300

# Outbound email. These values are suitable for a normal shared-hosting SMTP account.
# Leave SMTP_HOST / SMTP_FROM_EMAIL blank until outbound sending is intentionally enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MarketingIQ
SMTP_USE_SSL=false
SMTP_STARTTLS=true

# Optional shared-mailbox reply and DSN bounce ingestion.
# Credentials remain environment-only; the scanner opens the mailbox read-only.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
IMAP_STARTTLS=false
MAILBOX_ENGAGEMENT_BATCH_SIZE=100
